{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "git": { "deploymentEnabled": { "social-history": false } },
  "redirects": [{ "source": "/it", "destination": "/", "permanent": true }],
  "rewrites": [
    { "source": "/trips", "destination": "/shell" },
    { "source": "/trips/:path*", "destination": "/shell" },
    { "source": "/profile", "destination": "/shell" },
    { "source": "/explore", "destination": "/shell" },
    { "source": "/passport", "destination": "/shell" },
    { "source": "/p/:slug", "destination": "/api/public-trip?slug=:slug" },
    { "source": "/join", "destination": "/shell" },
    { "source": "/join/:code", "destination": "/api/join?code=:code" },
    { "source": "/join/:path*", "destination": "/shell" },
    { "source": "/auth/:path*", "destination": "/shell" },
    { "source": "/social/:path*", "destination": "https://tvcumfzhnuljngdzuuue.supabase.co/storage/v1/object/public/social/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org https://tile.openstreetmap.org https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://tvcumfzhnuljngdzuuue.supabase.co wss://tvcumfzhnuljngdzuuue.supabase.co https://nominatim.openstreetmap.org https://photon.komoot.io https://archive-api.open-meteo.com https://commons.wikimedia.org https://www.wikidata.org https://*.wikipedia.org https://upload.wikimedia.org https://thumb.wikimedia.org https://tile.openstreetmap.org; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/guides/photos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
