# Supabase project (Settings → API). The anon key is public by design: data is protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the deployed app, used to build invite links (no trailing slash).
# Falls back to window.location.origin when empty.
VITE_PUBLIC_APP_URL=

# Contact shown in the Privacy Policy and sent in the Nominatim/Wikimedia User-Agent policy header.
VITE_CONTACT_EMAIL=
